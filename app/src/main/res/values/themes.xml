<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      The app always renders in its dark "tournament table" theme, in day and
      night alike: a clock app lives in club lighting, and a light theme is
      illegible next to a wooden board. (No values-night/ override needed.)
    -->
    <style name="Theme.ChessClock" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_dim</item>

        <item name="chipStyle">@style/ChoiceChip</item>
        <item name="materialButtonStyle">@style/Widget.MaterialComponents.Button</item>
        <item name="textInputStyle">@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox</item>
        <item name="colorControlNormal">@color/text_dim</item>
        <item name="colorControlActivated">@color/accent</item>

        <!-- Top-bar icon buttons: always visible, high contrast in dark mode -->
        <item name="colorOnSurface">@color/text_dim</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="colorOnBackground">@color/text_dim</item>
    </style>

    <style name="CategoryChip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/choice_chip_bg</item>
        <item name="chipStrokeColor">@color/choice_chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="android:textColor">@color/choice_chip_text</item>
        <item name="ensureMinTouchTargetSize">false</item>
        <item name="chipMinHeight">40dp</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <style name="PresetChip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/choice_chip_bg</item>
        <item name="chipStrokeColor">@color/choice_chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="android:textColor">@color/choice_chip_text</item>
        <item name="ensureMinTouchTargetSize">false</item>
        <item name="chipMinHeight">44dp</item>
    </style>

    <style name="ChoiceChip" parent="Widget.MaterialComponents.Chip.Choice" />
</resources>
